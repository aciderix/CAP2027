# Vite injects VITE_* vars into the client bundle at build time.

# --- Supabase ---
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
# Publishable key (safe to embed in the client app — RLS guards the data)
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# --- AI Studio legacy (will move to backend later) ---
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
